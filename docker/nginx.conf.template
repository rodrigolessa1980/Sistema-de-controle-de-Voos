# =============================================================================
#  nginx do frontend.
#
#  Serve os estáticos e repassa /api para o container da API. Com isso o
#  navegador enxerga uma única origem, e o cookie httpOnly do refresh token
#  funciona sem CORS nem SameSite=None.
#
#  É um TEMPLATE: a imagem oficial do nginx troca `${API_UPSTREAM}` pelo valor
#  da variável de ambiente ao iniciar. No blue-green cada vaga aponta para a
#  sua API (`api-blue:1701` / `api-green:1701`); o padrão é `api:1701`.
#
#  Em produção quem recebe o tráfego é o nginx de borda (docker/edge), que
#  manda /api direto para a API. Este proxy continua servindo para o deploy
#  testar a vaga nova ponta a ponta ANTES de ela entrar no ar.
# =============================================================================

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Nunca anunciar a versão do nginx.
    server_tokens off;

    # Cabeçalhos de segurança básicos.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    client_max_body_size 8m;

    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Os assets levam hash no nome, então podem ser cacheados para sempre.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Resolver do Docker + variável no proxy_pass: o nome é resolvido a cada
    # requisição, não só na partida. Sem isso o nginx não sobe se a API ainda
    # não existe, e guarda o IP antigo se o container da API for recriado.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    # Versão servida agora. A tela compara com a dela para oferecer "Atualizar",
    # então nunca pode vir de cache.
    location = /version.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Upload de documento pode demorar mais que o padrão.
        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
    }

    # SPA: qualquer rota desconhecida devolve o index e o React Router resolve.
    # O index NÃO pode ser cacheado, senão um deploy novo não chega ao usuário.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
