# ============================================================
#  Air Charter Manager — variáveis de ambiente (TEMPLATE)
#  Copie para .env e preencha. O .env NUNCA vai para o git.
# ============================================================

# ---------- Banco de dados (MySQL 8) ----------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=aircharter

# String de conexão que o Prisma usa. Monte a partir das variáveis acima.
# Atenção: caracteres especiais na senha precisam de percent-encoding
# (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL="mysql://USER:SENHA_ENCODED@HOST:3306/aircharter?connection_limit=10&pool_timeout=20&connect_timeout=10"

# ---------- Portas ----------
# São ESTES nomes, em maiúsculas, que a aplicação lê (apps/api/src/env.ts e
# apps/web/vite.config.ts). O .env original do projeto trazia `porta_frontend`
# e `porta_backend` em minúsculas: são ignorados pelo código e mudá-los não
# tem efeito nenhum. Só `scripts/setup-github-secrets.ps1` ainda os aceita, ao
# montar as variables do GitHub.
PORT_FRONTEND=1700
PORT_BACKEND=1701

# ---------- Aplicação ----------
NODE_ENV=development
API_BASE_URL=http://localhost:1701
WEB_BASE_URL=http://localhost:1700
CORS_ORIGINS=http://localhost:1700
LOG_LEVEL=info
TZ=America/Sao_Paulo

# ---------- Autenticação / autorização ----------
# Gere novos com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=
BCRYPT_ROUNDS=12

# Chave AES-256 (hex, 32 bytes) para dados sensíveis em repouso.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------- Polling ----------
# Intervalo do polling do front, em ms. Requisito do projeto: 10 segundos.
POLL_INTERVAL_MS=10000
# Teto de itens retornados por página do change feed.
CHANGE_FEED_PAGE_SIZE=500

# ---------- Upload de documentos (LGPD: dado sensível) ----------
UPLOAD_DIR=./storage/documents
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
DOCUMENT_RETENTION_DAYS=365

# ---------- E-mail transacional ----------
# Obrigatório: o aviso de nova solicitação de voo depende disso (docs/PLANO.md §13).
# O domínio precisa de SPF e DKIM publicados, senão o aviso cai em spam.
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=nao-responda@aircharter.com.br
MAIL_FROM_NAME=Air Charter Manager
MAIL_REPLY_TO=operacoes@aircharter.com.br
# Em desenvolvimento: 1 = não envia nada, só grava a fila e loga.
MAIL_DRY_RUN=1

# ---------- Jobs em lote ----------
BATCH_SIZE=500
JOB_OVERDUE_CRON=*/5 * * * *
JOB_AGGREGATES_CRON=*/10 * * * *
JOB_PURGE_DOCUMENTS_CRON=0 3 * * *
JOB_EMAIL_OUTBOX_SECONDS=30

# ---------- Deploy (usado só pelo CI, nunca no .env local) ----------
SERVER_HOST=
SERVER_USER=
SERVER_PASSWORD=
SERVER_APP_DIR=/opt/aircharter
